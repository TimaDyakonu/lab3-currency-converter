<Window x:Class="CurrencyConverter.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:CurrencyConverter.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewmodels:MainViewModel}"
        Title="BNM Currency Converter" Height="500" Width="460"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F9"
        FontFamily="Segoe UI"
        FontSize="14">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title & Subtitle -->
            <RowDefinition Height="Auto"/> <!-- Amount Input -->
            <RowDefinition Height="Auto"/> <!-- Currencies Grid -->
            <RowDefinition Height="Auto"/> <!-- Action Buttons -->
            <RowDefinition Height="Auto"/> <!-- Validation Message -->
            <RowDefinition Height="*"/>    <!-- Result Area -->
            <RowDefinition Height="Auto"/> <!-- Metadata & Status Footer -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="BNM Currency Converter" FontSize="22" FontWeight="Bold" Foreground="#1E293B"/>
            <TextBlock Text="Official rates from National Bank of Moldova" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Amount -->
        <StackPanel Grid.Row="1" Margin="0,0,0,16">
            <TextBlock Text="Amount" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
            <TextBox x:Name="AmountTextBox"
                     Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged}"
                     Padding="10,8"
                     FontSize="15"
                     BorderBrush="#CBD5E1"
                     BorderThickness="1"
                     Height="40"
                     VerticalContentAlignment="Center"
                     Background="White"/>
        </StackPanel>

        <!-- Currencies Selection -->
        <Grid Grid.Row="2" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="From Currency" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                <ComboBox x:Name="SourceCurrencyComboBox"
                          ItemsSource="{Binding AvailableCurrencies}"
                          SelectedItem="{Binding SelectedSourceCurrency}"
                          Height="40"
                          VerticalContentAlignment="Center"
                          Background="White">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock>
                                <Run Text="{Binding Code, Mode=OneWay}" FontWeight="Bold"/>
                                <Run Text=" - "/>
                                <Run Text="{Binding Name, Mode=OneWay}" Foreground="#64748B"/>
                            </TextBlock>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="To Currency" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                <ComboBox x:Name="TargetCurrencyComboBox"
                          ItemsSource="{Binding AvailableCurrencies}"
                          SelectedItem="{Binding SelectedTargetCurrency}"
                          Height="40"
                          VerticalContentAlignment="Center"
                          Background="White">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock>
                                <Run Text="{Binding Code, Mode=OneWay}" FontWeight="Bold"/>
                                <Run Text=" - "/>
                                <Run Text="{Binding Name, Mode=OneWay}" Foreground="#64748B"/>
                            </TextBlock>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
        </Grid>

        <!-- Actions -->
        <Grid Grid.Row="3" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="ConvertButton"
                    Grid.Column="0"
                    Content="Convert"
                    Command="{Binding ConvertCommand}"
                    Height="42"
                    FontSize="15"
                    FontWeight="SemiBold"
                    Foreground="White"
                    Background="#2563EB"
                    BorderThickness="0"
                    Cursor="Hand"/>

            <Button x:Name="RefreshButton"
                    Grid.Column="2"
                    Content="Refresh Rates"
                    Command="{Binding RefreshRatesCommand}"
                    Height="42"
                    Padding="14,0"
                    FontSize="13"
                    Foreground="#334155"
                    Background="#E2E8F0"
                    BorderThickness="0"
                    Cursor="Hand"/>
        </Grid>

        <!-- Validation error message -->
        <Border Grid.Row="4" Margin="0,0,0,12"
                Background="#FEE2E2"
                BorderBrush="#EF4444"
                BorderThickness="1"
                CornerRadius="4"
                Padding="10,8"
                Visibility="{Binding HasValidationError, Converter={StaticResource BoolToVis}}">
            <TextBlock x:Name="ValidationTextBlock"
                       Text="{Binding ValidationMessage}"
                       Foreground="#B91C1C"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"/>
        </Border>

        <!-- Result Card -->
        <Border Grid.Row="5"
                Background="White"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16"
                Margin="0,0,0,16">
            <Grid>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Converted Amount"
                               FontSize="12"
                               Foreground="#94A3B8"
                               HorizontalAlignment="Center"
                               FontWeight="SemiBold"
                               Margin="0,0,0,4"/>
                    <TextBlock x:Name="ResultTextBlock"
                               Text="{Binding ResultText}"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="#0F172A"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <ProgressBar Height="4"
                             IsIndeterminate="True"
                             VerticalAlignment="Bottom"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
            </Grid>
        </Border>

        <!-- Metadata & Status -->
        <Border Grid.Row="6"
                Background="#F8FAFC"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12,10">
            <StackPanel>
                <Grid Margin="0,0,0,4">
                    <TextBlock x:Name="RateDateTextBlock"
                               Text="{Binding RateDateText}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="#475569"
                               HorizontalAlignment="Left"/>
                    <TextBlock x:Name="SourceTextBlock"
                               Text="{Binding SourceNameText}"
                               FontSize="11"
                               Foreground="#64748B"
                               HorizontalAlignment="Right"/>
                </Grid>
                <TextBlock x:Name="StatusTextBlock"
                           Text="{Binding StatusMessage}"
                           FontSize="11"
                           Foreground="#64748B"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
